amends "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Builtins.pkl"

profiles = List("docs", "code")

steps {
  ["autocorrect"] {
    profiles = List("docs")
[%- if stack == 'rust' %]
    glob = List("*.md", "*.rs")
[%- elif stack == 'uv' %]
    glob = List("*.md", "*.py")
[%- elif stack == 'bun' %]
    glob = List("*.md", "*.ts", "*.js")
[%- else %]
    glob = List("*.md")
[%- endif %]
    check = "autocorrect --config .config/autocorrectrc --lint {{files}}"
    fix = "autocorrect --config .config/autocorrectrc --fix {{files}}"
  }

  ["rumdl"] {
    profiles = List("docs")
    glob = List("*.md")
    check = "rumdl check --config .config/rumdl.toml {{files}}"
    fix = "rumdl check --config .config/rumdl.toml --fix {{files}}"
  }

  ["mmdr"] {
    profiles = List("docs", "!fmt")
    glob = List("*.md")
    check = "for f in {{files}}; do if grep -q '```mermaid' \"$f\"; then mmdr -i \"$f\" --size --fastText >/dev/null || exit 1; fi; done"
  }

  ["lychee"] {
    profiles = List("docs", "!fmt")
    glob = List("*.md")
    check = "lychee --config .config/lychee.toml --offline {{files}}"
  }

  ["typos"] = (Builtins.typos) {
    profiles = List("docs", "!fmt")
    exclude = List(".copier-answers.yml")
  }

  ["zizmor"] {
    profiles = List("code", "!fmt")
    glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
    check = "zizmor --offline --quiet {{files}}"
  }
[%- if stack == 'rust' %]

  ["cargo_fmt"] = (Builtins.cargo_fmt) {
    profiles = List("code")
  }

  ["ast_grep"] {
    profiles = List("code", "!fmt")
    glob = List("**/*.rs")
    check = "ast-grep scan {{files}}"
  }

  ["ast_grep_rules"] {
    profiles = List("code", "!fmt")
    glob = List("sgconfig.yml", "rules/**/*.yml")
    check = "ast-grep scan"
  }

  ["cargo_clippy"] {
    profiles = List("code", "!fmt")
    glob = List("**/*.rs", "Cargo.toml", "Cargo.lock", "clippy.toml")
    check = "cargo clippy --manifest-path Cargo.toml --all-targets -- -D warnings"
  }

  ["cargo_test"] {
    profiles = List("code", "!fmt")
    glob = List("**/*.rs", "Cargo.toml", "Cargo.lock")
    check = "cargo nextest run --manifest-path Cargo.toml --workspace --locked --no-tests=pass"
  }
[%- elif stack == 'uv' %]

  ["ruff_format"] {
    profiles = List("code")
    glob = List("*.py")
    check = "ruff format --check {{files}}"
    fix = "ruff format {{files}}"
  }

  ["ruff_check"] {
    profiles = List("code")
    glob = List("*.py")
    check = "ruff check {{files}}"
    fix = "ruff check --fix {{files}}"
  }

  ["ty"] {
    profiles = List("code", "!fmt")
    glob = List("*.py", "pyproject.toml")
    check = "ty check"
  }

  ["pytest"] {
    profiles = List("code", "!fmt")
    glob = List("*.py", "pyproject.toml", "uv.lock")
    check = "uv run pytest"
  }
[%- elif stack == 'bun' %]

  ["oxfmt"] = (Builtins.oxfmt) {
    profiles = List("code")
    exclude = List("*.md", ".copier-answers.yml")
  }

  ["oxlint"] {
    profiles = List("code")
    glob = List("*.ts", "*.js")
    check = "oxlint {{files}}"
    fix = "oxlint --fix {{files}}"
  }

  ["typecheck"] {
    profiles = List("code", "!fmt")
    glob = List("src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "tsconfig.json")
    check = "bun run typecheck"
  }

  ["bun_test"] {
    profiles = List("code", "!fmt")
    glob = List("src/**/*.ts", "tests/**/*.ts", "package.json")
    check = "bun test"
  }
[%- endif %]
}

hooks {
  ["commit-msg"] {
    steps {
      ["conventional_commit"] = Builtins.check_conventional_commit
    }
  }
}
