# yaml-language-server: $schema=https://json.schemastore.org/github-workflow.json

name: CI

on:
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]
[%- if visibility == 'public' %]
  merge_group:
[%- endif %]
  push:
    branches:
      - main

permissions: {}

concurrency:
  group: ci-${{ github.event.pull_request.head.sha || github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

jobs:
  plan:
    name: Path Filter
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: read
    outputs:
      docs: ${{ steps.filter.outputs.docs }}
      code: ${{ steps.filter.outputs.code }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: ${{ github.event_name == 'pull_request' && 1 || 0 }}
          persist-credentials: false
      - uses: dorny/paths-filter@ceb8a2b8f2d89434be7ff52d3de7ec3738c5cc9d # v4.0.3
        id: filter
        with:
          predicate-quantifier: "some-with-excludes"
          filters: |
            docs:
              - '**/*.md'
              - 'docs/**'
              - '.config/rumdl.toml'
              - '.config/autocorrectrc'
              - '.config/lychee.toml'
            code:
              - '**'
              - '!**/*.md'
              - '!docs/**'
              - '!LICENSE'
              - '!.config/rumdl.toml'
              - '!.config/autocorrectrc'
              - '!.config/lychee.toml'

  docs:
    name: Docs Checks
    needs: plan
    if: ${{ needs.plan.outputs.docs == 'true' || needs.plan.outputs.code == 'true' }}
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: jdx/mise-action@b44d12e7d0d8ee7461bb893e1b1993500433185b # v5.2.7
        with:
          install: true
      - name: Run docs checks
        run: mise x -- hk check --all -q --step autocorrect --step rumdl --step mmdr --step lychee --step typos
[%- if stack != 'base' %]

  checks:
    name: Checks
    needs: plan
    if: ${{ needs.plan.outputs.code == 'true' }}
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
[%- if stack == 'rust' %]
      - uses: dtolnay/rust-toolchain@683b588c487a69d01f6c6ddf40f036ff682cc2c8 # v1
        with:
          toolchain: stable
          components: rustfmt, clippy
      - uses: Swatinem/rust-cache@d1527c8f67ef9af357290475d4af4b0fab8f12e0 # v2.9.3
      - uses: jdx/mise-action@b44d12e7d0d8ee7461bb893e1b1993500433185b # v5.2.7
        with:
          install: true
      - name: Run code checks
        run: mise x -- hk check --all -q --step cargo_fmt --step ast_grep --step ast_grep_rules --step cargo_clippy --step cargo_test
[%- elif stack == 'uv' %]
      - uses: jdx/mise-action@b44d12e7d0d8ee7461bb893e1b1993500433185b # v5.2.7
        with:
          install: true
      - uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: ~/.cache/uv
          key: uv-${{ runner.os }}-${{ hashFiles('uv.lock') }}
          restore-keys: |
            uv-${{ runner.os }}-
      - name: Sync dependencies
        run: mise x -- uv sync --locked
      - name: Run code checks
        run: mise x -- hk check --all -q --step ruff_format --step ruff_check --step ty --step pytest
[%- elif stack == 'bun' %]
      - uses: jdx/mise-action@b44d12e7d0d8ee7461bb893e1b1993500433185b # v5.2.7
        with:
          install: true
      - uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: ~/.bun/install/cache
          key: bun-${{ runner.os }}-${{ hashFiles('bun.lock') }}
          restore-keys: |
            bun-${{ runner.os }}-
      - name: Install dependencies
        run: mise x -- bun install --frozen-lockfile
      - name: Run code checks
        run: mise x -- hk check --all -q --step oxfmt --step oxlint --step typecheck --step bun_test
[%- endif %]
[%- endif %]

  security:
    name: Security
    needs: plan
    if: ${{ needs.plan.outputs.code == 'true' }}
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: jdx/mise-action@b44d12e7d0d8ee7461bb893e1b1993500433185b # v5.2.7
        with:
          install: true
      - name: Scan workflows with zizmor
        run: mise x -- zizmor --quiet .github/workflows
      - name: Scan for leaked secrets
        run: mise x -- gitleaks git --verbose --redact .
[%- if stack == 'rust' %]
      - name: Audit dependencies with cargo-deny
        run: mise x -- cargo deny check
[%- elif stack == 'uv' %]
      - name: Audit dependencies with osv-scanner
        run: mise x -- osv-scanner scan source --lockfile=uv.lock
[%- elif stack == 'bun' %]
      - name: Audit dependencies with bun audit
        run: mise x -- bun audit --audit-level=high
[%- endif %]

  gate:
    name: Merge Gate
[%- if stack == 'base' %]
    needs: [plan, docs, security]
[%- else %]
    needs: [plan, docs, checks, security]
[%- endif %]
    if: always()
    runs-on: ubuntu-latest
    steps:
      - name: Verify required checks
        env:
          PLAN_RESULT: ${{ needs.plan.result }}
          DOCS_RESULT: ${{ needs.docs.result }}
[%- if stack != 'base' %]
          CHECKS_RESULT: ${{ needs.checks.result }}
[%- endif %]
          SECURITY_RESULT: ${{ needs.security.result }}
        run: |
          if [ "$PLAN_RESULT" != "success" ]; then
            exit 1
          fi
[%- if stack == 'base' %]
          for r in "$DOCS_RESULT" "$SECURITY_RESULT"; do
[%- else %]
          for r in "$DOCS_RESULT" "$CHECKS_RESULT" "$SECURITY_RESULT"; do
[%- endif %]
            if [ "$r" != "success" ] && [ "$r" != "skipped" ]; then
              exit 1
            fi
          done
