# yaml-language-server: $schema=https://json.schemastore.org/github-workflow.json

name: Scheduled Security

on:
  schedule:
    - cron: "30 23 * * 0"
  workflow_dispatch:

permissions: {}

jobs:
[%- if visibility == 'public' and stack != 'base' %]
  codeql:
    name: CodeQL Deep Scan
    runs-on: ubuntu-24.04
    permissions:
      actions: read
      contents: read
      security-events: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
[%- if stack == 'rust' %]
      - uses: dtolnay/rust-toolchain@683b588c487a69d01f6c6ddf40f036ff682cc2c8 # v1
        with:
          toolchain: stable
      - uses: Swatinem/rust-cache@d1527c8f67ef9af357290475d4af4b0fab8f12e0 # v2.9.3
      - uses: github/codeql-action/init@52cf1852265d99e9bea071b03366fc777a602909 # codeql-bundle-v2.27.4
        with:
          languages: rust
          queries: security-and-quality
          config-file: ./.github/codeql/codeql-config.yml
      - name: Build for CodeQL analysis
        run: cargo build --workspace --locked
[%- elif stack == 'uv' %]
      - uses: github/codeql-action/init@52cf1852265d99e9bea071b03366fc777a602909 # codeql-bundle-v2.27.4
        with:
          languages: python
          queries: security-and-quality
[%- elif stack == 'bun' %]
      - uses: github/codeql-action/init@52cf1852265d99e9bea071b03366fc777a602909 # codeql-bundle-v2.27.4
        with:
          languages: javascript-typescript
          queries: security-and-quality
[%- endif %]
      - uses: github/codeql-action/analyze@52cf1852265d99e9bea071b03366fc777a602909 # codeql-bundle-v2.27.4

[%- endif %]
[%- if stack == 'rust' %]
  cargo-deny:
    name: Weekly Dependency Audit
    runs-on: ubuntu-24.04
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: jdx/mise-action@236a21c3b91f5db6d4e174b348674a0f0caac06d # v5.2.9
        with:
          install: false
      - name: Install cargo-deny
        run: mise install cargo-deny
      - name: Run cargo-deny
        run: mise x -- cargo deny check

[%- elif stack == 'uv' %]
  osv-scanner:
    name: Weekly Dependency Audit
    runs-on: ubuntu-24.04
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: jdx/mise-action@236a21c3b91f5db6d4e174b348674a0f0caac06d # v5.2.9
        with:
          install: false
      - name: Install osv-scanner
        run: mise install osv-scanner
      - name: Run osv-scanner
        run: mise x -- osv-scanner scan source --lockfile=uv.lock

[%- elif stack == 'bun' %]
  bun-audit:
    name: Weekly Dependency Audit
    runs-on: ubuntu-24.04
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: jdx/mise-action@236a21c3b91f5db6d4e174b348674a0f0caac06d # v5.2.9
        with:
          install: false
      - name: Install bun
        run: mise install bun
      - name: Run bun audit
        run: mise x -- bun audit --audit-level=high

[%- endif %]
  zizmor:
    name: Workflow Security Audit
    runs-on: ubuntu-24.04
    permissions:
      contents: read
[%- if visibility == 'public' %]
      security-events: write
[%- endif %]
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: zizmorcore/zizmor-action@45d7276c9ca790aabd705e31ca99c6185c3e76dd # v0.8.1
[%- if visibility == 'private' %]
        with:
          advanced-security: false
[%- endif %]
