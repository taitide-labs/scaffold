id: no-client-import-runtime-outside-local
language: rust
severity: error
message: "严禁在 gateway local 适配器之外引用 backend/runtime"
files:
  - "clients/**/*.rs"
ignores:
  - "clients/gateway/src/local/**/*.rs"
rule:
  any:
    - kind: scoped_identifier
      regex: "^[[ package_module ]]_runtime(::|$)"
    - kind: use_declaration
      regex: "[[ package_module ]]_runtime"
