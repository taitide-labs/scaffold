use crate::cli::run;

fn run_with(args: &[&str]) -> (u8, String, String) {
    let owned: Vec<String> = args.iter().map(|item| (*item).to_string()).collect();
    let mut out = Vec::new();
    let mut err = Vec::new();
    let code = run(&owned, &mut out, &mut err);
    (
        code,
        String::from_utf8_lossy(&out).into_owned(),
        String::from_utf8_lossy(&err).into_owned(),
    )
}

#[test]
fn prints_version() {
    let (code, out, err) = run_with(&["--version"]);
    assert_eq!(code, 0);
    assert_eq!(out.trim(), "[[ project_name ]] 0.1.0");
    assert!(err.is_empty());
}

#[test]
fn prints_help_on_flag_and_empty_args() {
    let (flag_code, flag_out, flag_err) = run_with(&["--help"]);
    assert_eq!(flag_code, 0);
    assert!(flag_out.contains("Usage: [[ project_name ]]"));
    assert!(flag_err.is_empty());

    let (empty_code, empty_out, empty_err) = run_with(&[]);
    assert_eq!(empty_code, 0);
    assert_eq!(empty_out, flag_out);
    assert!(empty_err.is_empty());
}

#[test]
fn rejects_unknown_argument() {
    let (code, out, err) = run_with(&["--unknown"]);
    assert_eq!(code, 2);
    assert!(out.is_empty());
    assert!(err.contains("error: unknown argument: --unknown"));
}
