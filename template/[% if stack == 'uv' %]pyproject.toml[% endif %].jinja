[project]
name = "[[ project_name ]]"
version = "0.1.0"
description = "[[ description ]]"
readme = "README.md"
authors = [
    { name = "superxxl", email = "a1642947049@gmail.com" },
]
[% if visibility == 'public' %]license = "MIT"
[% else %]classifiers = ["Private :: Do Not Upload"]
[% endif %]requires-python = ">=3.14"
dependencies = []

[project.scripts]
[[ project_name ]] = "[[ package_module ]]:entrypoint"

[build-system]
requires = ["uv_build>=0.13.7,<0.14.0"]
build-backend = "uv_build"

[dependency-groups]
dev = [
    "pytest>=9.2.0",
]
