#:schema https://mise.jdx.dev/schema/mise.json

[tools]
hk = "2.12"
rumdl = "0.3.3"
lychee = "0.24.2"
typos = "1"
gitleaks = "8"
zizmor = "1"
"github:huacnlee/autocorrect" = "2.16.3"
"github:1jehuang/mermaid-rs-renderer" = "0.3.1"
[%- if stack == 'rust' %]
cargo-deny = "0.20.2"
ast-grep = "0.51.3"
sccache = "0.19.0"
"github:nextest-rs/nextest" = "cargo-nextest-0.9.152"
[%- elif stack == 'uv' %]
uv = "0.13"
ruff = "latest"
ty = "latest"
osv-scanner = "latest"
[%- elif stack == 'bun' %]
bun = "1.4"
oxlint = "latest"
oxfmt = "latest"
[%- endif %]
[%- if stack == 'bun' %]

[tasks.build]
description = "Build bundle"
run = "bun run build"
[%- endif %]

[tasks.check]
[%- if stack == 'rust' %]
description = "Run all documentation, formatting, ast-grep, clippy, test, and dependency audit checks"
run = ["hk check --all --silent -n", "cargo deny check"]
[%- elif stack == 'uv' %]
description = "Run all documentation, lint, test, and dependency audit checks"
run = ["hk check --all --silent -n", "osv-scanner scan source --lockfile=uv.lock"]
[%- elif stack == 'bun' %]
description = "Run all documentation, lint, test, and dependency audit checks"
run = ["hk check --all --silent -n", "bun audit --audit-level=high"]
[%- else %]
description = "Run all documentation, spelling, and workflow checks"
run = "hk check --all --silent -n"
[%- endif %]

[tasks.fmt]
[%- if stack == 'base' %]
description = "Auto-fix documentation formatting and typography"
[%- else %]
description = "Auto-fix documentation formatting, typography, and code formatting"
[%- endif %]
run = "hk fix --all --silent -n"
